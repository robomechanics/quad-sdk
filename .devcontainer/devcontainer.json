{
  "name": "ROS 2 Development Container",
  "remoteUser": "root",

  "dockerComposeFile": "docker-compose.yml",
  "service": "arm-mpc",

  "workspaceFolder": "/root/ros2_ws/src/quad-sdk",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "twxs.cmake",
        "donjayamanne.python-extension-pack",
        "eamodio.gitlens",
        "ms-iot.vscode-ros"
      ]
    }
  },

  "postStartCommand": "bash -lc 'source /opt/ros/jazzy/setup.bash'"
}
