<?xml version="1.0" encoding="utf-8"?>
<mujoco model="slope_20" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="meshdir" default=""/>
  <xacro:arg name="mjcf_path" default=""/>
  <!-- Absolute path to the heightmap rasterized from slope_20.stl. -->
  <xacro:arg name="terrain_heightmap" default=""/>

  <compiler
    angle="radian"
    meshdir="$(arg meshdir)"
    texturedir="$(arg meshdir)"
    autolimits="true"/>

  <option
    timestep="0.0015"
    iterations="100"
    ls_iterations="20"
    tolerance="1e-6"
    impratio="1.5"
     />

  <include file="$(arg mjcf_path)"/>


  <asset>
    <hfield name="terrain" file="$(arg terrain_heightmap)" size="4.5 2.0 0.8 0.5"/>
  </asset>

  <worldbody>
    <light directional="true" diffuse=".8 .8 .8" specular=".2 .2 .2" pos="0 0 5" dir="0 0 -1"/>


    <geom name="floor" type="hfield" hfield="terrain" pos="2.5 0 0" rgba="0.8 0.9 0.8 1"
          priority="2" condim="3"
          margin="0.005"
          friction="0.8 0.05 0.05"
          solref="0.02 1"
          solimp="0.9 0.95 0.001"/>
  </worldbody>
</mujoco>
