<?xml version="1.0"?>
<!-- V90 comparison fixture. Three co-located hinge axes approximate each spherical joint; independent bend limits are not an exact spherical cone. -->
<sdf xmlns:xacro="http://www.ros.org/wiki/xacro" version="1.9">
  <!-- Intermediate hinge links use 5e-4 kg m^2 rotational inertia.
       The former 1e-7 value caused DART LCP symmetry assertions under contact.
       This is numerical rotational regularization, not an exact PhysX armature. -->
  <model name="vine_v90">
    <xacro:arg name="model_name" default="underbrush3_vine" />
    <link name="bend_x_0">
      <pose>0 -0.565 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.0001</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <iyy>0.0005</iyy>
          <izz>0.0005</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <link name="bend_z_0">
      <pose>0 -0.565 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
