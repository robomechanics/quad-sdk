# ARM/Jetson, ONNX Runtime + ROS2 (Learned Policy Deployment on Robot)
# Requires: JetPack 6.x (L4T R36.4) with NVIDIA Container Runtime
# Base image includes: ONNX Runtime 1.22, CUDA 12.8, cuDNN 9.3, TensorRT, Ubuntu 24.04
# NOTE: Do not flash your Jetson to JetPack 6 until Unitree officially supports it on the Go2 EDU.
FROM dustynv/onnxruntime:1.22-r36.4.0-cu128-24.04

ENV DEBIAN_FRONTEND=noninteractive

# Install ROS2 Jazzy
SHELL ["/bin/bash", "-lc"]
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common \
        curl && \
    add-apt-repository universe && \
    curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
      -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    sh -c 'echo "deb [signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
      http://packages.ros.org/ros2/ubuntu noble main" > \
      /etc/apt/sources.list.d/ros2.list' && \
    apt-get update && apt-get install -y --no-install-recommends \
      ros-jazzy-ros-base \
      python3-colcon-common-extensions \
      python3-rosdep \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        vim \
        tmux \
        wget \
        chrony \
    && rm -rf /var/lib/apt/lists/*

RUN printf "server 192.168.8.103 iburst\nmakestep 0.1 3\nrtcsync\n" > /etc/chrony/chrony.conf

RUN rosdep init || true && rosdep update

RUN echo "source /opt/ros/jazzy/setup.bash" >> /etc/bash.bashrc

WORKDIR /root/ros2_ws

COPY ./ros_entrypoint.sh /
RUN chmod 755 /ros_entrypoint.sh
ENTRYPOINT ["/ros_entrypoint.sh"]

CMD ["bash"]
