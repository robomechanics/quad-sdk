<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>quad_controllers</name>
  <version>0.1.0</version>
  <description>
    ros2_control ControllerInterface plugins for quad-sdk. The leg control
    logic lives here and calls QuadKD2 (quad_utils) for kinematics/dynamics, so
    the same control law runs under controller_manager in Gazebo and on
    hardware. Depends only on quad_utils + quad_msgs 
  </description>
  <maintainer email="ologandavid@gmail.com">ologandavid</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>controller_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>quad_msgs</depend>
  <depend>quad_utils</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>eigen</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
