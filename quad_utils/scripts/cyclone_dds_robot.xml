<CycloneDDS>
    <!-- ROS 2 domain: communicate with remote computer over the 192.168.8.0/24 subnet.
         ROBOT_ROS_IP is set by init_robot.sh based on whichever interface has
         an address on that subnet, so this survives DHCP renewals and dongle swaps. -->
    <Domain Id="42">
        <General>
            <Interfaces>
                <NetworkInterface address="${ROBOT_ROS_IP}"/>
            </Interfaces>
            <AllowMulticast>false</AllowMulticast>
            <DontRoute>true</DontRoute>
            <MaxMessageSize>65500B</MaxMessageSize>
            <FragmentSize>1452B</FragmentSize>
        </General>
        <Internal>
            <!-- min="default": use the OS default as the floor, so node startup never
                 fails if the kernel won't grant a large buffer (avoids the
                 rmw_create_node crash when net.core.rmem_max is low).
                 max="128MB": still request a big buffer for throughput/loss resilience
                 when the kernel allows it (raise net.core.rmem_max to actually get it). -->
            <SocketReceiveBufferSize min="default" max="128MB"/>
            <SocketSendBufferSize min="default" max="128MB"/>
            <Watermarks>
                <WhcHigh>500kB</WhcHigh>
            </Watermarks>
        </Internal>
        <Discovery>
            <Peers>
                <Peer address="192.168.8.103"/>
            </Peers>
            <ParticipantIndex>auto</ParticipantIndex>
        </Discovery>
    </Domain>

    <!-- Unitree SDK domain: communicate with MCU (192.168.123.161) over the
         192.168.123.0/24 subnet. ROBOT_MCU_IP is set by init_robot.sh. -->
    <Domain Id="0">
        <General>
            <Interfaces>
                <NetworkInterface address="${ROBOT_MCU_IP}"/>
            </Interfaces>
        </General>
        <Discovery>
            <ParticipantIndex>auto</ParticipantIndex>
        </Discovery>
    </Domain>
</CycloneDDS>
